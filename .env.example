# Copy to .env (git-ignored) and fill in what you need.

# Your TMDB key or read access token, for development runs from the project folder.
# Installed copies don't read this: people add their key in Settings -> Metadata.
TMDB_API_KEY=

# Public GitHub repo (owner/name) whose releases installed copies update from. Built into
# release builds by scripts/package-windows.ps1.
MIRU_UPDATE_REPO=
